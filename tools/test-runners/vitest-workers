#!/bin/bash
# build-raptor custom test runner (see buildRaptor.testCommand in the package's package.json).
# Runs vitest with the Cloudflare Workers plugin so tests execute inside workerd.
#   $1 - absolute path of the package directory
#   $2 - package name
#   $3 - absolute path of the rerun file (unused: vitest reruns everything)
set -e
cd "$1"
# Invoke the package-local binary directly: `npx` prints "npm warn Unknown env config" lines
# under yarn's environment, which pollutes the captured test output.
exec ./node_modules/.bin/vitest run
