{
  "compilerOptions": {
    "module": "NodeNext",
    "inlineSourceMap": true,
    "newLine": "LF",
    "declaration": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noImplicitAny": true,
    "moduleResolution": "NodeNext",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "jest"]
  }
}
