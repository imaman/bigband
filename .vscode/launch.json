{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug current test file",
      "cwd": "${fileDirname}/..",
      "program": "${workspaceFolder}/node_modules/.bin/jest",
      "args": ["--runTestsByPath", "dist/tests/${fileBasenameNoExtension}.js", "--runInBand"],
      "env": {
        "NODE_OPTIONS": "--experimental-vm-modules"
      },
      "preLaunchTask": "build current module",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "sourceMaps": true
    }
  ]
}
