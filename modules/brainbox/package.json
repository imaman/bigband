{
  "name": "brainbox",
  "version": "1.0.0",
  "private": true,
  "description": "Cloudflare Worker (brainbox)",
  "keywords": [],
  "author": "",
  "type": "module",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc -b",
    "build-ui": "tsc -p tsconfig-ui.json && vite build && rm -f vite-dist/brainbox/.dev.vars",
    "cf-typegen": "wrangler types src/worker-configuration.d.ts",
    "check-cf-types": "wrangler types --check src/worker-configuration.d.ts",
    "deploy": "vite build && wrangler deploy",
    "dev": "vite dev",
    "preview": "vite build && vite preview",
    "test": "vitest run --config tests/vitest.config.mts",
    "test-harness": "vitest run --config tests/vitest.harness.config.mts"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "@tanstack/react-query": "^5.104.1",
    "hono": "^4.13.13",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "timeago.js": "^4.0.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.5",
    "@cloudflare/vitest-plugin": "^1.2.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.3.2",
    "vitest": "~4.1.0",
    "wrangler": "^4.147.0"
  },
  "buildRaptor": {
    "testCommand": "tools/test-runners/vitest-workers"
  },
  "buildTasks": {
    "build-ui": {
      "inputs": [
        "index.html",
        "ui",
        "src",
        "vite.config.ts",
        "tsconfig-ui.json",
        "wrangler.jsonc"
      ],
      "outputs": [
        "vite-dist"
      ],
      "labels": "build"
    },
    "check-cf-types": {
      "inputs": "_ALWAYS_",
      "outputs": [],
      "labels": "build-ci"
    },
    "test-harness": {
      "inputs": [
        "dist/tests",
        "vite-dist"
      ],
      "outputs": [],
      "labels": "test"
    }
  }
}
