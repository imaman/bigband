/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  /**
   * The Worker's name. It is the first label of the workers.dev URL (https://<name>.<account-subdomain>.workers.dev),
   * and it is how `wrangler deploy` identifies the Worker to update. Changing it deploys a new Worker next to the old
   * one, which keeps running. The new Worker also gets its own Durable Object storage, so it starts with no data.
   */
  "name": "brainbox",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-21",
  /**
   * Node.js compatibility (https://developers.cloudflare.com/workers/runtime-apis/nodejs/)
   * Already the default for compatibility dates from 2026-08-04 on. Spelled out because the type surface relies on it:
   * `@types/node` is in the module's TypeScript program (via tsconfig-base.json and, transitively, the vitest
   * plugin), so `Buffer`, `process`, `node:*` etc. type-check in src/. Lowering the compatibility date without this
   * flag would leave the types in place while the runtime lost the APIs.
   * The flag does not make types and runtime agree completely: `@types/node` describes all of Node, workerd
   * implements a subset (some modules are partial, e.g. node:os and node:tls; others are non-functional stubs, e.g.
   * node:http2, node:vm, node:child_process). Such code type-checks and fails at runtime; only the harness test
   * (tests/*.harness.spec.ts), which runs the worker with this exact configuration, can catch it.
   */
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  /**
   * Smart Placement
   * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
   */
  // "placement": {  "mode": "smart" }
  /**
   * Bindings
   * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
   * databases, object storage, AI inference, real-time communication and more.
   * https://developers.cloudflare.com/workers/runtime-apis/bindings/
   */
  /**
   * Environment Variables
   * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
   * Note: Use secrets to store sensitive data.
   * https://developers.cloudflare.com/workers/configuration/secrets/
   */
  "vars": {
    "ALLOWANCE": {
      "day": 40,
      "hour": 30,
      "minute": 15
    }
  },
  /**
   * Static Assets
   * https://developers.cloudflare.com/workers/static-assets/binding/
   */
  "assets": { "directory": "./public/" },

  /**
   * Durable Objects
   * https://developers.cloudflare.com/durable-objects/
   * `Backplane` counts the requests that reach the worker. A new Durable Object class must be declared
   * in a migration; `new_sqlite_classes` gives it the SQLite storage backend (the one available on the free plan).
   */
  "durable_objects": {
    "bindings": [{ "name": "BACKPLANE", "class_name": "Backplane" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Counter"] },
    { "tag": "v2", "renamed_classes": [{ "from": "Counter", "to": "Backplane" }] }
  ],

  /**
   * Service Bindings (communicate between multiple Workers)
   * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
   */
  // "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]

  /**
   * Previews (https://developers.cloudflare.com/workers/previews/configuration/)
   * Bindings are not inherited from the top level: every binding the code reads from `env` must be repeated here, or
   * it is `undefined` in a Preview. Durable Object classes and migrations stay at the top level; each Preview gets its
   * own Durable Object namespace and storage.
   */
  "previews": {
    "durable_objects": {
      "bindings": [{ "name": "BACKPLANE", "class_name": "Backplane" }]
    },
    "vars": {
      "ALLOWANCE": {
        "day": 40,
        "hour": 30,
        "minute": 15
      }
    }
  }
}
